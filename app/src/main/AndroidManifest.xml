<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      SudhaAutoBot is a 100% on-device macro: it needs no INTERNET permission and
      talks to no server. The only privileged capability it asks for is the
      accessibility service the user enables by hand in Settings.
    -->

    <!-- Floating panel over other apps (Oppo/Vivo "Display pop-up windows") -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- Used only to kill the engine on screen-off (battery friendliness) -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <queries>
        <package android:name="com.vrksignatures.sudhadairy" />
        <package android:name="com.sudha.dailyorders" />
    </queries>

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.SudhaAutoBot"
        tools:targetApi="34">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:screenOrientation="portrait"
            tools:ignore="LockedOrientationActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          accessibilityFlags="flagDefault|flagRetrieveInteractiveWindows|flagReportViewIds|flagIncludeNotImportantViews"
          typeWindowStateChanged|typeWindowContentChanged	|typeWindowsChanged
        -->
        <!--
          exported="true" is required: the system (settings) binds this service with
          BIND_ACCESSIBILITY_SERVICE, which only works for exported components.
          The android:permission below is what keeps other apps out.
        -->
        <service
            android:name=".SudhaAccessibilityService"
            android:exported="true"
            android:label="@string/service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>

            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>
    </application>

</manifest>
