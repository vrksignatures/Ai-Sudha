<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/app_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="18dp"
        android:paddingTop="28dp"
        android:paddingRight="18dp"
        android:paddingBottom="28dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:background="@drawable/dot_accent" />

            <TextView
                style="@style/AppText.Title"
                android:layout_marginStart="10dp"
                android:layout_marginLeft="10dp"
                android:text="@string/app_name" />
        </LinearLayout>

        <TextView
            android:id="@+id/subtitle_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Accessibility macro for Sudha Daily Orders"
            android:textColor="@color/muted"
            android:textSize="12sp" />

        <!-- Live status block -->
        <TextView
            android:id="@+id/status_text"
            style="@style/AppText.Status"
            android:layout_marginTop="18dp"
            android:text="Checking permissions…" />

        <!-- Target package -->
        <TextView style="@style/AppText.Section" android:text="TARGET PACKAGE" />

        <EditText
            android:id="@+id/input_package"
            style="@style/AppInput"
            android:autofillHints=""
            android:hint="@string/hint_target_package"
            android:imeOptions="actionDone"
            android:importantForAutofill="no" />

        <Button
            android:id="@+id/btn_save_package"
            style="@style/AppButton"
            android:layout_marginTop="8dp"
            android:text="@string/btn_save_target" />

        <!-- Permissions -->
        <TextView style="@style/AppText.Section" android:text="PERMISSIONS" />

        <Button
            android:id="@+id/btn_accessibility"
            style="@style/AppButton.Primary"
            android:text="@string/btn_accessibility" />

        <Button
            android:id="@+id/btn_overlay"
            style="@style/AppButton"
            android:layout_marginTop="8dp"
            android:text="@string/btn_overlay" />

        <!-- Panel control -->
        <TextView style="@style/AppText.Section" android:text="FLOATING PANEL" />

        <Button
            android:id="@+id/btn_toggle_panel"
            style="@style/AppButton.Warn"
            android:text="@string/btn_start_panel" />

        <Button
            android:id="@+id/btn_open_target"
            style="@style/AppButton"
            android:layout_marginTop="8dp"
            android:text="@string/btn_open_target" />

        <Button
            android:id="@+id/btn_reset_ledger"
            style="@style/AppButton"
            android:layout_marginTop="8dp"
            android:text="@string/btn_reset_ledger" />

        <!-- Instructions -->
        <TextView style="@style/AppText.Section" android:text="HOW TO RUN" />

        <TextView style="@style/AppText.Body" android:text="@string/flow_text" />

        <TextView style="@style/AppText.Section" android:text="HEADS-UP" />

        <TextView style="@style/AppText.Body" android:text="@string/notes_text" />

        <TextView
            android:id="@+id/version_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:gravity="center"
            android:textColor="@color/muted"
            android:textSize="10sp" />
    </LinearLayout>
</ScrollView>
